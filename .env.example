# --- LLM providers ---
# Set whichever of these you have a key for. At least one is required.
# If more than one is set, a provider is picked at random per process
# (override with LLM_PROVIDER). If OPENAI_API_KEY/ANTHROPIC_API_KEY/
# MISTRAL_API_KEY/DEEPSEEK_API_KEY are blank, that provider is ignored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Optional: force a specific provider instead of random selection among
# available keys. One of: openai | anthropic | mistral | deepseek
LLM_PROVIDER=

# Optional: override the default model for the selected provider
# (defaults: gpt-4o-mini / claude-opus-5 / mistral-large-latest / deepseek-chat)
LLM_MODEL=

# openai | huggingface (huggingface runs locally, no API key needed)
EMBEDDING_PROVIDER=huggingface

# --- ChromaDB ---
# Leave CHROMA_HOST blank to use an embedded on-disk store at data/chroma/
# (simplest for local dev). Set it to talk to a running Chroma server
# (e.g. "chromadb" inside docker-compose, or "localhost" outside Docker).
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_COLLECTION=ghana_parliament_hansard

# --- Scraper ---
PARLIAMENT_BASE_URL=https://www.parliament.gh
# Path (with query string) to the Hansard document listing, used by
# scraper/page_scraper.py to discover real sitting dates via Selenium
# instead of blindly probing every calendar day. Override if the site's
# structure changes again.
HANSARD_LISTING_PATH=/docs?type=HS
SCRAPE_DELAY_SECONDS=5
PDF_OUTPUT_DIR=data/raw

# How far back to backfill on a completely empty vector store (the first
# sync run). Subsequent runs only fetch what's new since the last indexed
# sitting date — see pipeline/sync.py and the `sync` service in
# docker-compose.yml, which runs this automatically once a day.
HANSARD_ARCHIVE_START_DATE=2017-01-01

# --- API ---
API_PORT=8000
